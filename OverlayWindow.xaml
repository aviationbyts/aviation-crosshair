<Window x:Class="AviationCrosshair.Overlay.OverlayWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Aviation Crosshair Overlay"
        WindowStyle="None"
        AllowsTransparency="True"
        Background="Transparent"
        ShowInTaskbar="False"
        Topmost="True"
        ResizeMode="NoResize"
        WindowStartupLocation="Manual"
        Focusable="False">
    <Canvas x:Name="RootCanvas" Background="Transparent">
        <Image x:Name="CrosshairImage" Stretch="None" RenderOptions.BitmapScalingMode="HighQuality" />
    </Canvas>
</Window>
